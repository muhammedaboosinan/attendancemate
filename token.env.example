# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (required for reminders)
# To get your chat ID:
# 1. Start a chat with your bot
# 2. Send any message
# 3. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 4. Find your chat ID in the response
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheet ID (REQUIRED if you already created a sheet)
# To get sheet ID: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# If left empty, bot will try to create a new sheet (requires available Drive storage)
GOOGLE_SHEET_ID=

# Scheduler Settings (optional)
CHECK_INTERVAL_MINUTES=1
REMINDER_RETRY_MINUTES=5
TIMEZONE=Asia/Kolkata